{
  "name": "react-midi-controls",
  "version": "1.0.1",
  "description": "React hooks and components for MIDI controller integration",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build --mode lib",
    "build:demo": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "lint": "eslint .",
    "type-check": "tsc -b"
  },
  "keywords": [
    "react",
    "midi",
    "hooks",
    "music",
    "controller",
    "web-midi",
    "typescript"
  ],
  "author": "Eurico Sá Fernandes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eeeurico/react-midi-controls.git"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.4",
    "vite-plugin-dts": "^4.5.4"
  }
}
